# ---------------------------------------------------------------------------
# 헤르메스 에이전트 설정 샘플  →  ~/.hermes/config.yaml
#                          (윈도우: %LOCALAPPDATA%\hermes\config.yaml)
#
# 실제 경로 확인:  hermes config path
#
# 🔒 이 파일에 API 키를 적지 마세요. 키는 .env 에만 넣습니다.
# ---------------------------------------------------------------------------

# ⚠️ 반드시 model.default 를 직접 지정하세요.
#    지정하지 않으면 헤르메스가 claude-fable-5 ($10/$50 per MTok)를 씁니다.
#    Sonnet 5의 5배 단가입니다.

model:
  # ── 경로 A) 앤트로픽 API 직접 (약관상 모호함 없음 · 권장) ──────────────
  #    모델 ID: 하이픈, 벤더 접두사 없음, 날짜 접미사 없음
  provider: "anthropic"
  default: "claude-sonnet-5"          # $2/$10  — 일상 업무용 권장
  # default: "claude-opus-5"          # $5/$25  — 어려운 추론이 필요할 때
  # default: "claude-haiku-4-5"       # $1/$5   — 단순 반복 작업

  # ── 경로 B) OpenRouter 경유 ────────────────────────────────────────────
  #    모델 ID 형식이 다릅니다: 벤더 접두사 + 점(.)
  #    ⚠️ 점이 들어간 ID는 `hermes config set` 이 깨집니다 (점을 키 구분자로 해석).
  #       이 파일을 직접 편집하거나 `hermes config edit` 를 쓰세요.
  # provider: "openrouter"
  # default: "anthropic/claude-opus-4.7"

  # ── 경로 C) 로컬 Ollama (무료, PC 사양 필요) ───────────────────────────
  # provider: "ollama"
  # default: "llama3.1:8b"

  # ❌ 절대 쓰지 말 것: provider 를 "claude" 또는 "claude-code" 로 두는 것.
  #    둘 다 "anthropic" 의 별칭이며, Claude Code 자격증명을 자동으로 읽어
  #    구독 OAuth 경로를 탑니다. 앤트로픽 약관 위반입니다.

# 프롬프트 캐싱 — 반복 작업 비용을 크게 줄입니다.
# API 키 경로의 캐시 TTL은 5분입니다. 질문을 몰아서 하세요.
# anthropic:
#   cache_ttl: "5m"

# 컨텍스트 길이는 보통 자동 감지됩니다.
# 헤르메스는 최소 64,000 토큰 이상을 요구합니다.
# context_length: 200000
