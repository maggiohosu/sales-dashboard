# ---------------------------------------------------------------------------
# 헤르메스 에이전트 설정 샘플  →  ~/.hermes/config.yaml
#
# 실제 경로 확인:  hermes config path
#
# ⚠️ 이 파일에 API 키를 적지 마세요. 키는 .env 에만 넣습니다.
# ---------------------------------------------------------------------------

model:
  # ── 경로 A) OpenRouter 경유 (입문 권장) ──────────────────────────────
  #    키 하나로 클로드·GPT·제미나이를 전부 씁니다.
  #    .env 에 OPENROUTER_API_KEY 필요.
  default: "anthropic/claude-opus-4.6"

  # ── 경로 B) 비용을 낮추고 싶을 때 ────────────────────────────────────
  # default: "anthropic/claude-sonnet-4.6"

  # ── 경로 C) 로컬 Ollama (무료, PC 사양 필요) ─────────────────────────
  # default: "ollama/llama3.1:8b"

# 프롬프트 캐싱 — 반복 작업 시 비용이 크게 줄어듭니다.
# Anthropic 네이티브 경로에서 유효합니다.
# anthropic:
#   cache_ttl: "5m"      # "5m" (기본) 또는 "1h"

# 컨텍스트 길이는 보통 자동 감지됩니다.
# 헤르메스는 최소 64,000 토큰 이상을 요구합니다.
# context_length: 200000
