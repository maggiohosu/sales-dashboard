# ---------------------------------------------------------------------------
# 헤르메스 에이전트 비밀키 샘플  →  ~/.hermes/.env
#
# 실제 경로 확인:  hermes config env-path
#
# 🔒 이 파일은 절대 깃/드라이브/카톡으로 공유하지 마세요.
#    API 키는 사실상 결제 수단입니다.
#
# 사용법: 필요한 줄의 맨 앞 # 을 지우고 값을 채우세요.
# ---------------------------------------------------------------------------

# ═══ 모델 (아래 중 하나만 채우면 됩니다) ═══════════════════════════════

# 경로 A) OpenRouter — 입문 권장. 키 하나로 여러 모델.
#         발급: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-

# 경로 B) Anthropic 직접 — 클로드만 쓸 때.
#         발급: https://console.anthropic.com
#         ⚠️ Claude Pro/Max 구독과는 별개의 종량제 청구입니다.
# ANTHROPIC_API_KEY=sk-ant-


# ═══ 슬랙 연동 (회사 운영용) ═══════════════════════════════════════════
# 발급: https://api.slack.com/apps  (Socket Mode 켜야 합니다)

# SLACK_BOT_TOKEN=xoxb-
# SLACK_APP_TOKEN=xapp-
# ⚠️ 아래를 비우면 워크스페이스 아무나 에이전트를 조종할 수 있습니다.
# SLACK_ALLOWED_USERS=U01ABCDEFG


# ═══ 텔레그램 연동 (개인용 · 더 가벼움) ════════════════════════════════
# 발급: 텔레그램에서 @BotFather → /newbot

# TELEGRAM_BOT_TOKEN=
# ⚠️ 아래를 비우면 봇을 아는 아무나 조종할 수 있습니다.
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=


# ═══ 선택: 웹 검색 · 크롤링 도구 ═══════════════════════════════════════
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
