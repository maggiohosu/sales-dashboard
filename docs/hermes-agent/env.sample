# ---------------------------------------------------------------------------
# 헤르메스 에이전트 비밀키 샘플  →  ~/.hermes/.env
#                            (윈도우: %LOCALAPPDATA%\hermes\.env)
#
# 실제 경로 확인:  hermes config env-path
# 권한 조이기:     chmod 600 ~/.hermes/.env
#
# 🔒 절대 깃/드라이브/카톡으로 공유하지 마세요. API 키 = 결제 수단입니다.
# ---------------------------------------------------------------------------

# ═══ 💰 비용 안전장치 — 제일 먼저 설정하세요 ═══════════════════════════
# 기본값은 500 입니다. 한 번의 질문에 도구 호출을 500회까지 반복하며,
# 지시 하나 잘못 이해하면 한 턴에 $37~75 가 날아갑니다.
HERMES_MAX_ITERATIONS=30


# ═══ 모델 (아래 중 하나만) ═════════════════════════════════════════════

# 경로 A) 앤트로픽 직접 — 약관상 모호함 없음. 비개발자에게 권장.
#         발급: https://platform.claude.com
#         ⚠️ Claude Pro/Max 구독과 완전히 별개인 종량제 선불 계정입니다.
#         ⚠️ 콘솔에서 지출 한도(Spend limit)를 먼저 걸고, 선불 크레딧 $20만
#            충전한 뒤 auto-reload 는 OFF 로 두세요. 그게 진짜 안전장치입니다.
# ANTHROPIC_API_KEY=sk-ant-api03-

# 경로 B) OpenRouter — 잔액 하나로 여러 모델. 단가는 앤트로픽과 동일.
#         발급: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-

# ❌ CLAUDE_CODE_OAUTH_TOKEN 은 설정하지 마세요.
#    헤르메스가 이 값을 받아 구독 OAuth 경로를 타며, 앤트로픽 약관 위반입니다.

# ⚠️ 셸에 export 된 ANTHROPIC_API_KEY 가 이 파일보다 우선합니다.
#    엉뚱한 키를 쓰는 것 같으면:  env | grep ANTHROPIC


# ═══ 슬랙 연동 ═════════════════════════════════════════════════════════
# 발급: https://api.slack.com/apps  (Socket Mode 필수)

# SLACK_BOT_TOKEN=xoxb-
# SLACK_APP_TOKEN=xapp-
# ⚠️ 비우면 워크스페이스 아무나 에이전트를 조종합니다. 반드시 채우세요.
# SLACK_ALLOWED_USERS=U01ABCDEFG


# ═══ 텔레그램 연동 ═════════════════════════════════════════════════════
# 발급: 텔레그램에서 @BotFather → /newbot

# TELEGRAM_BOT_TOKEN=
# ⚠️ 비우면 봇을 아는 아무나 조종합니다. 반드시 채우세요.
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=


# ═══ 선택: 웹 검색 · 크롤링 ════════════════════════════════════════════
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
